@article{hitit2026insystematic,
  author  = {Hitit, O{\u{g}}uz Ka{\u{g}}an and Girrbach, Leander and
             Akata, Zeynep},
  title   = {{A Systematic Study of In-the-Wild Model Merging for
             Large Language Models}},
  journal = {arXiv preprint arXiv:2511.21437},
  year    = {2026},
  note    = {Published in Transactions on Machine Learning Research,
             March 2026. Evaluates six merge methods across four
             open-weight LLMs (Llama 3.2 3B, Qwen3 4B, Llama 3.1 8B,
             Qwen3 8B), twelve fine-tuned checkpoints each, sixteen
             standard benchmarks. Finds that subspace-based methods
             (TIES, Iso-C, TSV-M) produce large parameter-space
             displacements correlating with catastrophic forgetting,
             and that Task Arithmetic is the only approach that
             reliably yields performance gains at decoder scale.}
}


