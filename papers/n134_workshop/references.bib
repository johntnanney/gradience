% https://arxiv.org/abs/2605.02038
% Surfaced via 2026-05-06 daily research review. Eleventh voice in the
% parallel-development register; multi-variant reliability-audit register
% covering measurement dimensions (calibration, verbal-confidence,
% evaluator-side failure modes) complementary to the present paper's
% measurement-discipline framework.
@article{karmakar2026singleprompt,
  author        = {Karmakar, Ranit and Chatterjee, Jayita},
  title         = {What Single-Prompt Accuracy Misses: A Multi-Variant
                   Reliability Audit of Language Models},
  year          = {2026},
  eprint        = {2605.02038},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CL},
  doi           = {10.48550/arXiv.2605.02038},
  note          = {15-model open-weight corpus (10 instruct primary)
                   across 5 classification/reasoning benchmarks under 5
                   prompt variants per cell. Three findings: evaluation
                   design materially changes conclusions (ECE-token
                   definition shifts calibration by mean abs 0.149;
                   chain-of-thought + first-character evaluator on
                   ARC-Challenge cuts apparent accuracy 72-88\%); verbal
                   confidence exceeds both accuracy and token-probability
                   confidence; prompt robustness does not track parameter
                   count reliably (corr -0.244 to 0.474). Argues
                   calibration definitions, evaluator logic, verbal
                   parseability, and prompt robustness should be reported
                   explicitly when making reliability claims.}
}

