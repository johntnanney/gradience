\bibitem[Heineman et~al.(2025)Heineman, Hofmann, Magnusson, Gu, Smith,
  Hajishirzi, Lo, and Dodge]{heineman2025signal}
David Heineman, Valentin Hofmann, Ian Magnusson, Yuling Gu, Noah~A. Smith,
  Hannaneh Hajishirzi, Kyle Lo, and Jesse Dodge.
\newblock Signal and noise: A framework for reducing uncertainty in language
  model evaluation, 2025.
\newblock Allen Institute for AI and University of Washington. Defines
  benchmark "signal" (between-model variance / total variance) and "noise"
  (training-step trajectory variability) on 30 benchmarks and 375 open-weight
  models. Released dataset of 900K evaluation results / 200M instances.
  Companion repo: github.com/allenai/signal-and-noise.

\bibitem[Hitit et~al.(2026)Hitit, Girrbach, and Akata]{hitit2026insystematic}
O{\u{g}}uz~Ka{\u{g}}an Hitit, Leander Girrbach, and Zeynep Akata.
\newblock {A Systematic Study of In-the-Wild Model Merging for Large Language
  Models}.
\newblock \emph{arXiv preprint arXiv:2511.21437}, 2026.
\newblock Published in Transactions on Machine Learning Research, March 2026.
  Evaluates six merge methods across four open-weight LLMs (Llama 3.2 3B, Qwen3
  4B, Llama 3.1 8B, Qwen3 8B), twelve fine-tuned checkpoints each, sixteen
  standard benchmarks. Finds that subspace-based methods (TIES, Iso-C, TSV-M)
  produce large parameter-space displacements correlating with catastrophic
  forgetting, and that Task Arithmetic is the only approach that reliably
  yields performance gains at decoder scale.

