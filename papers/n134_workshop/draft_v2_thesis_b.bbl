\bibitem[Lior et~al.(2025)Lior, Habba, Levy, Caciularu, and
  Stanovsky]{lior2025reliableeval}
Gili Lior, Eliya Habba, Shahar Levy, Avi Caciularu, and Gabriel Stanovsky.
\newblock {ReliableEval}: A recipe for stochastic {LLM} evaluation via method
  of moments.
\newblock In \emph{Findings of the Association for Computational Linguistics:
  {EMNLP} 2025}, 2025.
\newblock \doi{10.48550/arXiv.2505.22169}.
\newblock SLAB-NLP, Hebrew University of Jerusalem. Defines reliable evaluation
  as the expected accuracy under a distribution of meaning-preserving prompt
  perturbations; estimates the expectation by method-of-moments resampling and
  provides a recipe for the number of resamples needed for a stable estimate.
  Demonstrated on five frontier LLMs (GPT-4o, Claude-3.7-Sonnet and three
  others). Companion repository: github.com/SLAB-NLP/Reliable-Eval.

\bibitem[McGregor et~al.(2025)McGregor, Lu, Tashev, Foundjem, Ramasethu,
  Zarkouei, Knotz, Chen, Parrish, Reuel, and Frase]{mcgregor2025benchrisk}
Sean McGregor, Victor Lu, Vassil Tashev, Armstrong Foundjem, Aishwarya
  Ramasethu, Sadegh AlMahdi~Kazemi Zarkouei, Chris Knotz, Kongtao Chen, Alicia
  Parrish, Anka Reuel, and Heather Frase.
\newblock Risk management for mitigating benchmark failure modes: {BenchRisk}.
\newblock In \emph{Advances in Neural Information Processing Systems
  (NeurIPS)}, 2025.
\newblock \doi{10.48550/arXiv.2510.21460}.
\newblock Responsible AI Collaborative + Google DeepMind + collaborators. Uses
  NIST risk management process to analyze 26 popular LLM benchmarks; identifies
  57 failure modes and 196 mitigation strategies; scores benchmarks on five
  dimensions (comprehensiveness, intelligibility, consistency, correctness,
  longevity). Finds all 26 benchmarks present significant risk within one or
  more dimensions. CC-BY-SA 4.0.

