{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gradience.local/schemas/item_level_normalized.schema.json",
  "title": "Item-Level Normalized Row",
  "description": "Logical schema for a single row in runs/normalized/item_level_*.parquet. Null values are permitted where a column is scoring-rule-specific (LL-only or G&P-only). See SPEC_CPU_v0_2.md §5.5.",
  "type": "object",
  "required": [
    "condition_id",
    "tier",
    "benchmark_id",
    "model_id",
    "model_family",
    "model_type",
    "parameter_count_b",
    "prompt_id",
    "prompt_source_type",
    "fewshot_k",
    "scoring_rule_id",
    "task_type",
    "item_id",
    "gold_answer",
    "is_correct",
    "prompt_text_hash",
    "rendered_prompt_hash",
    "run_id",
    "created_at"
  ],
  "properties": {
    "condition_id":             {"type": "string"},
    "tier":                     {"type": "string", "enum": ["primary", "secondary"]},
    "benchmark_id":             {"type": "string"},
    "subject_id":               {"type": ["string", "null"]},
    "model_id":                 {"type": "string"},
    "model_family":             {"type": "string"},
    "model_type":               {"type": "string", "enum": ["base", "instruct"]},
    "parameter_count_b":        {"type": "number", "minimum": 0},
    "prompt_id":                {"type": "string"},
    "prompt_source_type":       {"type": "string"},
    "seed_id":                  {"type": ["string", "null"]},
    "fewshot_k":                {"type": "integer", "minimum": 0},
    "scoring_rule_id":          {"type": "string"},
    "task_type":                {"type": "string", "enum": ["constrained_choice", "open_generation"]},
    "item_id":                  {"type": "string"},
    "gold_answer":              {"type": "string"},
    "predicted_answer":         {"type": ["string", "null"]},
    "is_correct":               {"type": "boolean"},
    "parse_status":             {
      "type": ["string", "null"],
      "enum": ["parsed", "unparseable", "empty", "multiple_answers", "invalid_choice", "runtime_error", null]
    },
    "parseable":                {"type": ["boolean", "null"]},
    "choice_count":             {"type": ["integer", "null"], "minimum": 0},
    "prompt_text_hash":         {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rendered_prompt_hash":     {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id":                   {"type": "string"},
    "created_at":               {"type": "string", "format": "date-time"},
    "selected_answer":          {"type": ["string", "null"]},
    "ll_margin_top2":           {"type": ["number", "null"]},
    "gold_choice_score":        {"type": ["number", "null"]},
    "selected_choice_score":    {"type": ["number", "null"]},
    "raw_generation":           {"type": ["string", "null"]},
    "parsed_answer":            {"type": ["string", "null"]},
    "generation_length_tokens": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
