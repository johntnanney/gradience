{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gradience.local/schemas/condition_level.schema.json",
  "title": "Condition-Level Row",
  "description": "Logical schema for a single row in runs/normalized/condition_level_*.csv. See SPEC_CPU_v0_2.md §5.6.",
  "type": "object",
  "required": [
    "condition_id",
    "tier",
    "benchmark_id",
    "model_id",
    "prompt_id",
    "fewshot_k",
    "scoring_rule_id",
    "num_items",
    "num_correct",
    "accuracy",
    "condition_status"
  ],
  "properties": {
    "condition_id":                  {"type": "string"},
    "tier":                          {"type": "string", "enum": ["primary", "secondary"]},
    "benchmark_id":                  {"type": "string"},
    "subject_id":                    {"type": ["string", "null"]},
    "model_id":                      {"type": "string"},
    "prompt_id":                     {"type": "string"},
    "seed_id":                       {"type": ["string", "null"]},
    "fewshot_k":                     {"type": "integer", "minimum": 0},
    "scoring_rule_id":               {"type": "string"},
    "num_items":                     {"type": "integer", "minimum": 1},
    "num_correct":                   {"type": "integer", "minimum": 0},
    "accuracy":                      {"type": "number", "minimum": 0, "maximum": 1},
    "parseability_rate":             {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "mean_generation_length_tokens": {"type": ["number", "null"], "minimum": 0},
    "condition_status":              {
      "type": "string",
      "enum": ["pending", "running", "complete", "failed", "excluded_pre_run", "excluded_post_run"]
    }
  },
  "additionalProperties": false
}
