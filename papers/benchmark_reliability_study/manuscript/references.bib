% setup (§\ref{sec:framework}, §\ref{sec:construct-articulation}).
% Cited at the §\ref{sec:construct-articulation} inferential-view
% articulation as register-level convergence on the framework move,
% and at §\ref{sec:distinguishing-targets} for the
% prescriptive-output distinction (their adaptive-sampling algorithm
% for ability estimation vs.\ the present paper's per-cell
% decimal-place precision tolerance schedule).
@article{jo2025evalinference,
  author        = {Jo, Nathanael and Wilson, Ashia},
  title         = {What Does Your Benchmark Really Measure? A Framework
                   for Robust Inference of {AI} Capabilities},
  year          = {2025},
  eprint        = {2509.19590},
  archivePrefix = {arXiv},
  primaryClass  = {cs.AI},
  doi           = {10.48550/arXiv.2509.19590},
  note          = {Articulates evaluation-as-inference as the correct
                   framing for AI evaluation: benchmark scores are
                   inferences from a model of capability, not direct
                   measurements; an evaluation methodology must begin
                   from a theory of capability and derive estimation
                   methods from it. The framing is familiar from
                   psychometrics and is the same framework move the
                   present paper makes (§\ref{sec:construct-articulation}).
                   Proof of concept addresses sensitivity to
                   perturbations: introduces an ability-model
                   formulation and methods that infer ability while
                   accounting for uncertainty from sensitivity and
                   finite samples, including an adaptive algorithm that
                   significantly reduces sample complexity. Framework-
                   level peer to the present paper, with a different
                   prescriptive output (adaptive sampling for ability
                   estimation vs.\ per-cell decimal-place precision
                   tolerance schedule). Convergence between Jo \&
                   Wilson and the present paper on the framework move
                   is itself register-level evidence the framing is
                   methodology-invariant rather than artifact of any
                   single articulation.}
}

